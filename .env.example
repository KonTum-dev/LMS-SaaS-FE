# Development: the browser and backend run on the developer's machine.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production on one VPS: use this absolute public URL when building the FE.
# NEXT_PUBLIC_API_URL=https://lms.dolphinxstudio.com/api/v1
# Nginx forwards /api/v1/ to http://127.0.0.1:4000 on the VPS.
# Do not use browser localhost or a relative URL in production: image/media
# origin validation requires an absolute API URL. See deploy/same-domain-pm2.md.
